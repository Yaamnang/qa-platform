STORE=

SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Claude, for the real AI job (npm run qa -- --ai-mode claude). When set, Explore also lets Claude drive its read-only browser.
ANTHROPIC_API_KEY=

# Explore only. Probe never uses a model.
# Model that drives Explore and writes its proposals. Blank means claude-haiku-5-5.
EXPLORE_MODEL=
# Most browsing decisions Claude may take in one Explore run. Blank means 20.
EXPLORE_MAX_STEPS=
# Hard cap on input plus output tokens for one Explore run; it stops and keeps what it mapped. Blank means 200000.
EXPLORE_MAX_TOKENS=

# QA console GitHub polling. Connecting needs no OAuth app: an employee pastes a personal access token on the workspace's GitHub page.
# How often the console checks watched branches for new commits, in ms. Default 60000. 0 turns the poller off (use on extra servers sharing one database).
GITHUB_POLL_MS=
# The console's public address, used for the job links in GitHub commit statuses. Blank means http://localhost:$PORT.
CONSOLE_PUBLIC_URL=
